<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#070b16"><title>SmartStudy V5</title>
<style>
:root{--bg:#070b16;--c:#101728;--c2:#151e31;--t:#f7f9ff;--m:#94a3b8;--l:#ffffff16;--a:#7c5cff;--b:#22d3ee;--ok:#37d98a}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 0 0,#31207855,transparent 32%),radial-gradient(circle at 100% 0,#0b7b9650,transparent 30%),var(--bg);color:var(--t);font:15px system-ui,sans-serif}.w{max-width:1250px;margin:auto;padding:18px}header,.row{display:flex;align-items:center;gap:10px}header{justify-content:space-between;margin-bottom:18px}.brand{display:flex;align-items:center;gap:11px}.logo{width:45px;height:45px;border-radius:14px;display:grid;place-items:center;font-size:22px;font-weight:900;background:linear-gradient(135deg,var(--a),var(--b))}.brand h1{margin:0;font-size:20px}.brand small,.mut{color:var(--m)}button{border:1px solid var(--l);background:var(--c);color:var(--t);border-radius:11px;padding:10px 13px;cursor:pointer}.primary{background:linear-gradient(135deg,var(--a),#527dff);border:0;font-weight:800}.hero,.card,.stat{background:#101728e8;border:1px solid var(--l);border-radius:20px;box-shadow:0 18px 55px #0003}.hero{padding:28px;background:linear-gradient(135deg,#7c5cff26,#22d3ee0b)}.heroGrid{display:grid;grid-template-columns:1.55fr .85fr;gap:20px}.pill{display:inline-block;padding:6px 9px;border-radius:99px;background:#37d98a18;color:var(--ok);font-size:11px;font-weight:800}.hero h2{font-size:clamp(35px,5vw,58px);line-height:.98;margin:13px 0}.hero p{color:var(--m);max-width:650px;line-height:1.6}.heroPanel{background:#070b1670;border:1px solid var(--l);padding:18px;border-radius:18px}.between{justify-content:space-between}.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:15px 0}.stat,.card{padding:16px}.stat b{font-size:25px}.stat small{display:block;color:var(--m);margin-top:4px}.layout{display:grid;grid-template-columns:1.45fr .85fr;gap:15px}.card{margin-bottom:15px}.card h3{margin:0 0 13px}input,textarea{width:100%;background:#080d19;color:var(--t);border:1px solid var(--l);padding:11px;border-radius:10px;outline:0}textarea{min-height:90px}.progress{height:9px;background:#050812;border-radius:99px;overflow:hidden}.bar{height:100%;width:0;background:linear-gradient(90deg,var(--a),var(--b));transition:.3s}.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.chip{background:var(--c2);padding:8px 10px;border-radius:99px}.task{display:flex;gap:11px;padding:12px 0;border-bottom:1px solid var(--l);align-items:center}.task:last-child{border:0}.task input{width:19px}.task.done .name{text-decoration:line-through;color:var(--m)}.day{color:var(--a);font-size:11px;font-weight:800}.clock{text-align:center;font-size:55px;font-weight:900}.modes{text-align:center}.modes button.active{background:var(--a);border-color:transparent}.notes{display:grid;gap:7px}.note,.ach div{padding:10px;background:var(--c2);border-radius:10px}.ach{display:grid;grid-template-columns:1fr 1fr;gap:7px}.locked{opacity:.35}.insight{line-height:1.55;color:var(--m)}.empty{color:var(--m);padding:10px 0}.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,30px);opacity:0;background:white;color:#111;padding:11px 16px;border-radius:12px;font-weight:800;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}footer{text-align:center;color:var(--m);font-size:11px;padding:6px}@media(max-width:900px){.heroGrid,.layout{grid-template-columns:1fr}.stats{grid-template-columns:repeat(3,1fr)}}@media(max-width:560px){.w{padding:11px}.hero{padding:20px}.stats{grid-template-columns:repeat(2,1fr)}.hero h2{font-size:38px}}
</style></head><body><div class="w">
<header><div class="brand"><div class="logo">S</div><div><h1>SmartStudy V5</h1><small>Student Operating System</small></div></div><div><button onclick="theme()">◐</button><button onclick="resetApp()">↺</button></div></header>
<section class="hero"><div class="heroGrid"><div><span class="pill">● COLLEGE PROJECT • V5</span><h2>Your study.<br>Your system.</h2><p>Plan your week, focus deeply, track XP, capture notes and see your progress in one fast offline-first dashboard.</p><button class="primary" onclick="plan()">✨ Build My Smart Plan</button></div><div class="heroPanel"><div class="row between"><b>Today's Progress</b><b id="pct">0%</b></div><div class="progress" style="margin:10px 0"><div class="bar" id="bar"></div></div><div id="mission" class="insight">Add subjects to begin.</div><hr style="border:0;border-top:1px solid var(--l);margin:15px 0"><div class="row between"><span>Exam countdown</span><b id="cd">—</b></div></div></div></section>
<div class="stats"><div class="stat"><b id="st">0</b><small>🔥 Streak</small></div><div class="stat"><b id="sc">0</b><small>📚 Subjects</small></div><div class="stat"><b id="dc">0</b><small>✅ Completed</small></div><div class="stat"><b id="xp">0</b><small>⚡ XP</small></div><div class="stat"><b id="lv">1</b><small>🏆 Level</small></div></div>
<div class="layout"><main>
<div class="card"><h3>🎯 Goal Control</h3><div class="row"><input id="exam" type="date"><input id="hours" type="number" min="1" max="12" placeholder="Hours/day"></div><button class="primary" style="margin-top:9px" onclick="goal()">Save Goal</button></div>
<div class="card"><h3>📚 Subjects</h3><div class="row"><input id="sub" placeholder="Add a subject"><button class="primary" onclick="add()">Add</button></div><div id="chips" class="chips"></div></div>
<div class="card"><div class="row between"><h3>🧠 AI-Style Weekly Planner</h3><button onclick="plan()">Regenerate</button></div><div id="tasks"></div></div>
<div class="card"><h3>📊 Performance</h3><div class="row between"><span>Completion</span><b id="perf">0%</b></div><div class="progress" style="margin:9px 0"><div class="bar" id="pbar"></div></div><div id="ins" class="insight">Complete tasks to generate insights.</div></div>
</main><aside>
<div class="card"><h3>⏱️ Focus Lab</h3><div class="modes"><button class="active" onclick="mode(25,this)">25m</button><button onclick="mode(50,this)">50m</button><button onclick="mode(5,this)">5m</button></div><div class="clock" id="clock">25:00</div><button class="primary" style="width:100%" id="tb" onclick="timer()">Start Focus</button></div>
<div class="card"><h3>📝 Quick Notes</h3><textarea id="note" placeholder="Formula, idea, reminder..."></textarea><button class="primary" style="margin-top:8px" onclick="note()">Save Note</button><div id="notes" class="notes" style="margin-top:9px"></div></div>
<div class="card"><h3>🏆 Achievement Lab</h3><div id="ach" class="ach"></div></div>
<div class="card"><h3>🤖 Study Coach</h3><div id="coach" class="insight">Your coach reads your progress and gives a quick next step.</div><button onclick="coach()">Coach Me</button></div>
</aside></div><footer>SmartStudy V5 • localStorage • Works offline</footer></div><div id="toast" class="toast"></div>
<script>
const K='smartstudy_v5';let s=JSON.parse(localStorage.getItem(K)||'null')||{subjects:[],tasks:[],notes:[],xp:0,streak:0,exam:'',hours:2};let sec=1500,base=1500,run=false,it;
const $=x=>document.getElementById(x);function save(){localStorage.setItem(K,JSON.stringify(s));render()}function msg(t){let x=$('toast');x.textContent=t;x.classList.add('show');setTimeout(()=>x.classList.remove('show'),1700)}
function add(){let i=$('sub'),v=i.value.trim();if(!v)return;if(!s.subjects.includes(v)){s.subjects.push(v);i.value='';save();msg('Subject added 📚')}}function rem(v){s.subjects=s.subjects.filter(x=>x!==v);save()}function goal(){s.exam=$('exam').value;s.hours=+$('hours').value||2;save();msg('Goal saved 🎯')}
function plan(){if(!s.subjects.length){msg('Add a subject first');return}let d=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];s.tasks=d.map((day,i)=>({id:Date.now()+i,day,subject:s.subjects[i%s.subjects.length],type:['Deep Study','Practice','Revision'][i%3],done:false}));save();msg('7-day plan created ✨')}
function toggle(id){let t=s.tasks.find(x=>x.id===id);t.done=!t.done;s.xp=Math.max(0,s.xp+(t.done?25:-25));save()}
function note(){let i=$('note'),v=i.value.trim();if(!v)return;s.notes.unshift(v);i.value='';save();msg('Note saved 📝')}function del(i){s.notes.splice(i,1);save()}
function mode(m,b){document.querySelectorAll('.modes button').forEach(x=>x.classList.remove('active'));b.classList.add('active');clearInterval(it);run=false;base=sec=m*60;sec=base;clock();$('tb').textContent='Start Focus'}
function clock(){let m=Math.floor(sec/60),q=sec%60;$('clock').textContent=String(m).padStart(2,'0')+':'+String(q).padStart(2,'0')}
function timer(){if(run){clearInterval(it);run=false;$('tb').textContent='Resume Focus';return}run=true;$('tb').textContent='Pause';it=setInterval(()=>{sec--;clock();if(sec<=0){clearInterval(it);run=false;s.xp+=20;save();msg('Focus complete! +20 XP 🎉');sec=base;clock();$('tb').textContent='Start Focus'}},1000)}
function coach(){let n=s.tasks.length,d=n?s.tasks.filter(t=>t.done).length/n:0;$('coach').textContent=!n?'Add subjects and build your plan first.':d<.4?'Do one 25-minute focus session now. Momentum beats perfection.':d<.8?'Nice progress. Protect your focus and finish the remaining tasks.':'🔥 Excellent! Finish with revision and practice.'}
function countdown(){if(!s.exam){$('cd').textContent='—';return}let d=Math.ceil((new Date(s.exam+'T23:59:59')-new Date())/86400000);$('cd').textContent=d>=0?d+'d':'Passed'}
function esc(x){return x.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function render(){$('st').textContent=s.streak;$('sc').textContent=s.subjects.length;$('dc').textContent=s.tasks.filter(t=>t.done).length;$('xp').textContent=s.xp;$('lv').textContent=Math.floor(s.xp/100)+1;$('exam').value=s.exam;$('hours').value=s.hours;$('chips').innerHTML=s.subjects.map(v=>`<span class="chip">${esc(v)} <button onclick="rem('${v.replace(/'/g,"\\'")}')" style="padding:0;border:0;background:transparent">×</button></span>`).join('')||'<span class="empty">No subjects yet.</span>';$('tasks').innerHTML=s.tasks.length?s.tasks.map(t=>`<div class="task ${t.done?'done':''}"><input type="checkbox" ${t.done?'checked':''} onchange="toggle(${t.id})"><div><div class="name"><b>${esc(t.subject)}</b> — ${t.type}</div><span class="day">${t.day}</span></div></div>`).join(''):'<div class="empty">Build your smart plan to see the week.</div>';let total=s.tasks.length,d=s.tasks.filter(t=>t.done).length,p=total?Math.round(d/total*100):0;$('pct').textContent=p+'%';$('bar').style.width=p+'%';$('perf').textContent=p+'%';$('pbar').style.width=p+'%';$('mission').textContent=total?`${total-d} task${total-d===1?'':'s'} remaining. ${p>=80?'You are crushing it! 🔥':'Keep one focused session going.'}`:'Add subjects to begin.';$('ins').textContent=total?`Completed ${d}/${total} tasks. ${p>=80?'Strong consistency.':p>=40?'Solid start — keep building.':'Start with one task today.'}`:'Complete tasks to generate insights.';$('notes').innerHTML=s.notes.map((n,i)=>`<div class="note">${esc(n)} <button onclick="del(${i})" style="float:right;padding:2px 7px">×</button></div>`).join('')||'<div class="empty">No notes yet.</div>';let a=[['🔥 First Task',d>=1],['⚡ 100 XP',s.xp>=100],['🏆 5 Tasks',d>=5],['👑 Level 5',Math.floor(s.xp/100)+1>=5]];$('ach').innerHTML=a.map(x=>`<div class="${x[1]?'':'locked'}">${x[0]}<br><small>${x[1]?'Unlocked':'Locked'}</small></div>`).join('');countdown()}
function theme(){document.body.classList.toggle('light');if(document.body.classList.contains('light')){document.documentElement.style.setProperty('--bg','#f4f7fb');document.documentElement.style.setProperty('--c','#fff');document.documentElement.style.setProperty('--c2','#eef2f8');document.documentElement.style.setProperty('--t','#111827');document.documentElement.style.setProperty('--m','#64748b')}else location.reload()}function resetApp(){if(confirm('Reset SmartStudy?')){localStorage.removeItem(K);location.reload()}}render();clock();setInterval(countdown,60000);
</script></body></html>
